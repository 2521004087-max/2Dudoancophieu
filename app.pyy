
import random
from datetime import date, timedelta

import numpy as np
import pandas as pd
import streamlit as st
import yfinance as yf
import matplotlib.pyplot as plt
import tensorflow as tf

from sklearn.preprocessing import MinMaxScaler
from sklearn.metrics import (
    mean_squared_error,
    mean_absolute_error,
    r2_score,
)
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, Dense, Input
from tensorflow.keras.callbacks import EarlyStopping


# ==================================================
# 1. CẤU HÌNH
# ==================================================

SEED = 42
np.random.seed(SEED)
random.seed(SEED)
tf.random.set_seed(SEED)

st.set_page_config(
    page_title="Dự báo giá cổ phiếu LSTM",
    page_icon="📈",
    layout="wide",
)

st.title("📈 DỰ BÁO GIÁ CỔ PHIẾU BẰNG LSTM")
st.write(
    "Ứng dụng dự báo giá đóng cửa từ dữ liệu lịch sử "
    "bằng mạng nơ-ron LSTM hai tầng."
)

st.warning(
    "Kết quả chỉ phục vụ học tập và nghiên cứu, "
    "không phải khuyến nghị đầu tư."
)


# ==================================================
# 2. HÀM TẢI DỮ LIỆU
# ==================================================

@st.cache_data(ttl=1800, show_spinner=False)
def download_data(ticker, start_date, end_date):
    df = yf.download(
        ticker,
        start=start_date.isoformat(),
        end=(end_date + timedelta(days=1)).isoformat(),
        auto_adjust=False,
        progress=False,
        threads=False,
    )

    if df.empty:
        return pd.DataFrame()

    # Hỗ trợ cả cột thông thường và MultiIndex
    if isinstance(df.columns, pd.MultiIndex):
        close = df["Close"]

        if isinstance(close, pd.DataFrame):
            close = close.iloc[:, 0]
    else:
        close = df["Close"]

    result = pd.DataFrame({
        "Close": pd.to_numeric(close, errors="coerce")
    })

    result.index = pd.to_datetime(result.index)
    result = result.dropna()
    result = result[
        np.isfinite(result["Close"].to_numpy())
    ]

    return result


# ==================================================
# 3. HÀM TẠO CHUỖI DỮ LIỆU
# ==================================================

def create_sequences(data, window_size):
    X, y = [], []

    for i in range(window_size, len(data)):
        X.append(data[i - window_size:i])
        y.append(data[i])

    return np.asarray(X), np.asarray(y)


# ==================================================
# 4. GIAO DIỆN ĐIỀU KHIỂN
# ==================================================

with st.sidebar:
    st.header("⚙️ Thiết lập mô hình")

    ticker = st.text_input(
        "Mã cổ phiếu Yahoo Finance",
        value="VNM.VN",
    ).strip().upper()

    start_date = st.date_input(
        "Ngày bắt đầu",
        value=date(2018, 1, 1),
        max_value=date.today(),
    )

    end_date = st.date_input(
        "Ngày kết thúc",
        value=date.today(),
        max_value=date.today(),
    )

    window_size = st.selectbox(
        "Số phiên lịch sử đầu vào",
        [30, 45, 60, 90],
        index=2,
    )

    forecast_days = st.slider(
        "Số phiên dự báo",
        min_value=1,
        max_value=30,
        value=10,
    )

    epochs = st.slider(
        "Số epoch tối đa",
        min_value=3,
        max_value=50,
        value=10,
    )

    run_button = st.button(
        "🚀 Chạy mô hình",
        type="primary",
        use_container_width=True,
    )


st.caption(
    "Ví dụ mã cổ phiếu: VNM.VN, FPT.VN, HPG.VN. "
    "Mã phải được Yahoo Finance hỗ trợ."
)

if not run_button:
    st.info(
        "Chọn thông số ở thanh bên, sau đó nhấn "
        "'Chạy mô hình'."
    )
    st.stop()


# ==================================================
# 5. KIỂM TRA ĐẦU VÀO
# ==================================================

if not ticker:
    st.error("Vui lòng nhập mã cổ phiếu.")
    st.stop()

if start_date >= end_date:
    st.error("Ngày bắt đầu phải trước ngày kết thúc.")
    st.stop()


# ==================================================
# 6. TẢI DỮ LIỆU
# ==================================================

try:
    with st.spinner("Đang tải dữ liệu cổ phiếu..."):
        df = download_data(ticker, start_date, end_date)

except Exception as exc:
    st.error(f"Lỗi tải dữ liệu: {exc}")
    st.stop()

if df.empty:
    st.error(
        "Không tìm thấy dữ liệu. Kiểm tra mã cổ phiếu, "
        "khoảng thời gian hoặc kết nối Yahoo Finance."
    )
    st.stop()

if len(df) < window_size + 30:
    st.error(
        f"Có {len(df)} phiên dữ liệu. "
        f"Hãy chọn khoảng thời gian dài hơn; "
        f"cần tối thiểu khoảng {window_size + 30} phiên."
    )
    st.stop()


# ==================================================
# 7. THÔNG TIN VÀ BIỂU ĐỒ LỊCH SỬ
# ==================================================

col1, col2, col3 = st.columns(3)

col1.metric(
    "Giá đóng cửa gần nhất",
    f"{df['Close'].iloc[-1]:,.2f}",
)

col2.metric("Số phiên dữ liệu", f"{len(df):,}")

col3.metric(
    "Ngày gần nhất",
    df.index[-1].strftime("%d/%m/%Y"),
)

st.subheader(f"Giá lịch sử — {ticker}")

fig, ax = plt.subplots(figsize=(12, 4))
ax.plot(df.index, df["Close"], label="Giá đóng cửa")
ax.set_xlabel("Ngày")
ax.set_ylabel("Giá")
ax.grid(alpha=0.25)
ax.legend()
fig.tight_layout()
st.pyplot(fig)
plt.close(fig)

with st.expander("Xem dữ liệu gần nhất"):
    st.dataframe(df.tail(20), use_container_width=True)


# ==================================================
# 8. CHIA TRAIN / TEST VÀ CHUẨN HÓA
# ==================================================

data = df[["Close"]].to_numpy(dtype=float)

train_size = int(0.8 * len(data))

train_data = data[:train_size]
test_data = data[train_size:]

if len(train_data) <= window_size or len(test_data) < 2:
    st.error("Không đủ dữ liệu để huấn luyện và kiểm tra.")
    st.stop()

# Chỉ fit scaler trên tập train để tránh rò rỉ dữ liệu
scaler = MinMaxScaler()

train_scaled = scaler.fit_transform(train_data)
test_scaled = scaler.transform(test_data)

X_train, y_train = create_sequences(
    train_scaled,
    window_size,
)

# Dùng những phiên train cuối làm cửa sổ đầu vào test
test_combined = np.vstack([
    train_scaled[-window_size:],
    test_scaled,
])

X_test, y_test = create_sequences(
    test_combined,
    window_size,
)

X_train = X_train.reshape(-1, window_size, 1)
X_test = X_test.reshape(-1, window_size, 1)

if len(X_train) < 2 or len(X_test) == 0:
    st.error("Không đủ mẫu dữ liệu để tạo chuỗi LSTM.")
    st.stop()

val_size = max(1, int(0.1 * len(X_train)))

X_train_final = X_train[:-val_size]
y_train_final = y_train[:-val_size]

X_val = X_train[-val_size:]
y_val = y_train[-val_size:]

if len(X_train_final) == 0:
    st.error("Không đủ mẫu huấn luyện sau khi chia validation.")
    st.stop()


# ==================================================
# 9. XÂY DỰNG MÔ HÌNH LSTM
# ==================================================

model = Sequential([
    Input(shape=(window_size, 1)),
    LSTM(50, return_sequences=True),
    LSTM(50),
    Dense(1),
])

model.compile(
    optimizer="adam",
    loss="mean_squared_error",
)

early_stop = EarlyStopping(
    monitor="val_loss",
    patience=5,
    restore_best_weights=True,
)


# ==================================================
# 10. HUẤN LUYỆN
# ==================================================

st.subheader("🧠 Huấn luyện mô hình")

try:
    with st.spinner(
        "Đang huấn luyện LSTM. Vui lòng chờ..."
    ):
        history = model.fit(
            X_train_final,
            y_train_final,
            validation_data=(X_val, y_val),
            epochs=epochs,
            batch_size=32,
            shuffle=False,
            callbacks=[early_stop],
            verbose=0,
        )

except Exception as exc:
    st.error(f"Lỗi huấn luyện mô hình: {exc}")
    st.stop()

st.success(
    f"Huấn luyện hoàn tất sau "
    f"{len(history.history['loss'])} epoch."
)


# ==================================================
# 11. DỰ BÁO TẬP TEST
# ==================================================

pred_scaled = model.predict(X_test, verbose=0)

test_pred = scaler.inverse_transform(
    pred_scaled
).ravel()

y_test_real = scaler.inverse_transform(
    y_test.reshape(-1, 1)
).ravel()


# ==================================================
# 12. ĐÁNH GIÁ MÔ HÌNH
# ==================================================

rmse = np.sqrt(
    mean_squared_error(y_test_real, test_pred)
)

mae = mean_absolute_error(y_test_real, test_pred)

r2 = (
    r2_score(y_test_real, test_pred)
    if len(y_test_real) > 1
    else float("nan")
)

st.subheader("📊 Đánh giá trên tập kiểm tra")

c1, c2, c3 = st.columns(3)

c1.metric("RMSE", f"{rmse:.4f}")
c2.metric("MAE", f"{mae:.4f}")
c3.metric(
    "R²",
    f"{r2:.4f}" if np.isfinite(r2) else "N/A",
)


# ==================================================
# 13. BIỂU ĐỒ LOSS
# ==================================================

st.subheader("Loss huấn luyện và validation")

fig, ax = plt.subplots(figsize=(10, 4))

ax.plot(
    history.history["loss"],
    label="Train Loss",
)

ax.plot(
    history.history["val_loss"],
    label="Validation Loss",
)

ax.set_xlabel("Epoch")
ax.set_ylabel("MSE")
ax.grid(alpha=0.25)
ax.legend()
fig.tight_layout()
st.pyplot(fig)
plt.close(fig)


# ==================================================
# 14. BIỂU ĐỒ TEST
# ==================================================

st.subheader("Giá thực tế và giá dự báo")

test_dates = df.index[train_size:]

fig, ax = plt.subplots(figsize=(12, 5))

ax.plot(
    test_dates,
    y_test_real,
    label="Giá thực tế",
)

ax.plot(
    test_dates,
    test_pred,
    label="Giá dự báo",
)

ax.set_xlabel("Ngày")
ax.set_ylabel("Giá đóng cửa")
ax.grid(alpha=0.25)
ax.legend()
fig.tight_layout()
st.pyplot(fig)
plt.close(fig)


# ==================================================
# 15. DỰ BÁO CÁC PHIÊN TIẾP THEO
# ==================================================

st.subheader(
    f"🔮 Dự báo {forecast_days} phiên giao dịch tiếp theo"
)

all_scaled = np.vstack([
    train_scaled,
    test_scaled,
])

last_window = all_scaled[-window_size:].reshape(
    1,
    window_size,
    1,
)

future_scaled = []

for _ in range(forecast_days):
    next_pred = model.predict(
        last_window,
        verbose=0,
    )

    future_scaled.append(float(next_pred[0, 0]))

    last_window = np.concatenate(
        [
            last_window[:, 1:, :],
            next_pred.reshape(1, 1, 1),
        ],
        axis=1,
    )

future_prices = scaler.inverse_transform(
    np.asarray(future_scaled).reshape(-1, 1)
).ravel()

# Ngày làm việc dự kiến, chưa loại trừ mọi ngày nghỉ lễ
future_dates = pd.bdate_range(
    start=df.index[-1] + pd.Timedelta(days=1),
    periods=forecast_days,
)

forecast_df = pd.DataFrame({
    "Phiên": np.arange(1, forecast_days + 1),
    "Ngày dự kiến": future_dates.strftime("%d/%m/%Y"),
    "Giá đóng cửa dự báo": future_prices,
})

st.dataframe(
    forecast_df.style.format({
        "Giá đóng cửa dự báo": "{:,.2f}",
    }),
    use_container_width=True,
    hide_index=True,
)

# ==================================================
# 16. BIỂU ĐỒ DỰ BÁO TƯƠNG LAI
# ==================================================

fig, ax = plt.subplots(figsize=(12, 5))

recent = df.tail(min(90, len(df)))

ax.plot(
    recent.index,
    recent["Close"],
    label="Giá lịch sử",
)

ax.plot(
    future_dates,
    future_prices,
    marker="o",
    linestyle="--",
    label="Giá dự báo",
)

ax.set_xlabel("Ngày")
ax.set_ylabel("Giá đóng cửa")
ax.grid(alpha=0.25)
ax.legend()
fig.tight_layout()
st.pyplot(fig)
plt.close(fig)


# ==================================================
# 17. TẢI KẾT QUẢ
# ==================================================

csv_data = forecast_df.to_csv(
    index=False,
).encode("utf-8-sig")

st.download_button(
    label="📥 Tải kết quả dự báo CSV",
    data=csv_data,
    file_name=f"du_bao_{ticker.replace('.', '_')}.csv",
    mime="text/csv",
)

st.warning(
    "Dự báo dựa trên giá lịch sử, không phản ánh đầy đủ "
    "tin tức, báo cáo tài chính, thanh khoản hay các sự kiện "
    "doanh nghiệp. Kết quả có thể sai lệch đáng kể và "
    "không phải lời khuyên mua hoặc bán cổ phiếu."
)
